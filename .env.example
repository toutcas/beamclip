# Optional: configure beamclip via environment instead of the UI / config.json.
# Anything set here overrides config.json. Copy to ".env" is NOT auto-loaded —
# either export these in your shell or set them in your process manager.

# Buffer personal API key (Buffer → Settings → API → Personal Keys)
BUFFER_API_KEY=

# S3-compatible storage (Cloudflare R2, AWS S3, Backblaze B2, MinIO, …)
S3_ENDPOINT=            # R2: https://<accountid>.r2.cloudflarestorage.com  | AWS S3: leave blank
S3_REGION=auto          # AWS: e.g. eu-central-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=     # public URL that maps to the bucket (R2 r2.dev / custom domain / CDN)

# Server port (default 4310)
PORT=4310
